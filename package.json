{
  "name": "omp-agent-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "clean": "node scripts/clean.mjs",
    "db:backup": "node scripts/sqlite-maintenance.mjs backup",
    "db:verify": "node scripts/sqlite-maintenance.mjs verify",
    "db:restore": "node scripts/sqlite-maintenance.mjs restore",
    "dev": "concurrently --kill-others-on-fail --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome check src tests scripts vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:agents": "tsx scripts/validate-agent-commands.ts",
    "verify:omp": "node scripts/verify-omp-rpc.mjs",
    "smoke:live-omp": "tsx scripts/smoke-live-omp.ts",
    "verify": "npm run validate:agents && npm run typecheck && npm run lint && npm test && npm run build && npm audit --audit-level=high && npm run verify:omp"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  }
}
